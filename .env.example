# Railway Postgres 를 붙이면 PG* 변수는 자동으로 들어온다
PGHOST=localhost
PGPORT=5432
PGDATABASE=prguard
PGUSER=prguard
PGPASSWORD=prguard

# PR 에 코멘트를 다는 봇 계정 PAT. 비우면 코멘트 없이 DB 에만 저장(dry-run)
GITHUB_TOKEN=
# 비우면 AI 리뷰 없이 변경 통계만 남긴다
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
# 열린 PR 조회 주기 (ISO-8601)
POLL_INTERVAL=PT5M
