# Railway Postgres 를 붙이면 PG* 변수는 자동으로 들어온다
PGHOST=localhost
PGPORT=5432
PGDATABASE=prguard
PGUSER=prguard
PGPASSWORD=prguard

# PR 에 코멘트를 다는 봇 계정 PAT. 비우면 코멘트 없이 DB 에만 저장(dry-run)
GITHUB_TOKEN=
# false 면 토큰이 있어도 PR 에 코멘트를 달지 않는다 (로컬 개발용)
GITHUB_COMMENT_ENABLED=true
# 비우면 AI 리뷰 없이 변경 통계만 남긴다
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# 열린 PR 조회 주기 (ISO-8601)
POLL_INTERVAL=PT5M
# GitHub 웹훅 secret. 있으면 PR 이 열리거나 커밋이 올라오자마자 리뷰한다 (POST /api/github/webhook)
GITHUB_WEBHOOK_SECRET=
# 있으면 /api/** 는 X-Api-Token 헤더가 이 값이어야 받는다 (pr-guard-web 의 API_TOKEN 과 같은 값)
API_TOKEN=

# Hypothesis: 서버는 GitHub Actions 실행 요청과 결과 수집만 수행한다.
# invariant-check.yml을 기본 브랜치에 반영하고 GITHUB_TOKEN에 Actions 읽기/쓰기 권한을 설정한 후 활성화.
INVARIANT_EXEC_ENABLED=false
INVARIANT_WORKFLOW_REPO=dongguk-creative-fusion-2026/pr-guard-api
INVARIANT_WORKFLOW_REF=main
# GuardDog v3 CLI가 설치된 Linux/macOS 실행 환경에서 활성화 (기본 꺼짐)
GUARDDOG_ENABLED=false
GUARDDOG_EXECUTABLE=guarddog
GUARDDOG_TIMEOUT=PT1M
GUARDDOG_TOTAL_TIMEOUT=PT3M
GUARDDOG_MAX_PACKAGES=20
GUARDDOG_MAX_OUTPUT_BYTES=1048576
GUARDDOG_INCLUDE_DEV_DEPENDENCIES=true

# 열린 PR 간 수정 영역 겹침 분석. Windows 로컬은 python 또는 Python 실행 파일의 절대 경로
PR_CONFLICT_ENABLED=true
PR_CONFLICT_PYTHON=python3
PR_CONFLICT_TIMEOUT=PT30S
PR_CONFLICT_MAX_PULLS=30
# Semgrep 검사 (C. 보안 · D. 버그 패턴 · 모범 사례 · 팀 규칙 · 마이그레이션). 로컬에서는 pip install semgrep 이 필요하다. 규칙은 쉼표로 여러 개
SEMGREP_ENABLED=true
SEMGREP_CONFIGS=p/default,p/r2c-best-practices
# SonarCloud (실행 검증이 켜져 있어야 돈다). 우리 조직에 레포마다 프로젝트를 만든다
SONAR_ENABLED=false
SONAR_ORGANIZATION=
SONAR_TOKEN=
